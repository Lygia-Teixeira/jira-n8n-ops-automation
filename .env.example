# Variáveis de ambiente do n8n (configuração, NÃO segredos).
# Segredos (token do Jira, chaves SSH, tokens WHM, webhooks com token) vão no
# cofre de credenciais do n8n. Copie para .env (chmod 600) e ajuste.

# --- n8n ---------------------------------------------------------------------
# Os nós leem configuração via $env: libere o acesso e só coloque aqui o que
# pode ser lido por quem edita workflows.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Gerador de senha usa crypto.randomInt
NODE_FUNCTION_ALLOW_BUILTIN=crypto
NODE_FUNCTION_ALLOW_EXTERNAL=
N8N_ENCRYPTION_KEY=CHANGE_ME

# IDs dos subworkflows depois de importar (Workflow > Settings > ID)
WF_INFRA_ID=CHANGE_ME
WF_NEWS_ID=CHANGE_ME

# --- Jira --------------------------------------------------------------------
JIRA_BASE_URL=https://example.atlassian.net
JIRA_PROJECT_KEYS=OPS
JIRA_AUTOMATION_STATUS=Selecionado para Automação
JIRA_STATUS_DONE=Conferir e Avisar
JIRA_STATUS_TRIAGE=Triagem Manual
JIRA_CLAIM_LABEL=ops-automation-claimed
JIRA_SEARCH_MAX_RESULTS=25
JIRA_BOT_ACCOUNT_ID=CHANGE_ME

# --- Guardrails --------------------------------------------------------------
# Contas Jira autorizadas a mover cards para a coluna de automação (vírgula)
OPS_APPROVER_ACCOUNT_IDS=CHANGE_ME
# Quem abriu o card não pode ser quem aprovou
OPS_REQUIRE_FOUR_EYES=true
# true = só registra o que faria. Troque para false apenas após homologar.
OPS_DRY_RUN=true
# Allowlist: ip_unblock, mail_quota_increase, mail_password_reset (vazio = nada executa)
OPS_ALLOWED_ACTIVITIES=ip_unblock
OPS_MAX_ACTIONS_PER_RUN=5
# forced-command (recomendado) ou sudo-wrapper
OPS_SSH_MODE=forced-command
OPS_PASSWORD_LENGTH=20
OPS_SECRET_TTL_HOURS=24
# Inventário em uma linha (ver config/inventory.example.json)
OPS_INVENTORY_JSON={"servers":{"srv-01":{"host":"srv-01.example.com"}},"accounts":{"clientea":{"server":"srv-01","domains":["cliente-a.example.com"],"aliases":["Cliente A"],"contact":"contato-a@example.com"}}}

# --- Serviços externos (URLs; a autenticação fica nas credenciais do n8n) -----
SECRET_DELIVERY_URL=https://secrets.example.com/api/v1/one-time
AUDIT_SINK_URL=https://audit.example.com/api/v1/events
NEWS_PUBLISHER_URL=https://news-publisher.example.com/api/v1/jobs

# --- SSL / Teams -------------------------------------------------------------
SSL_MAX_RETRIES=1
SSL_DEDUP_HOURS=12
# A URL de webhook do Teams contém token: trate como segredo (veja docs/importacao.md)
TEAMS_WEBHOOK_URL=CHANGE_ME
